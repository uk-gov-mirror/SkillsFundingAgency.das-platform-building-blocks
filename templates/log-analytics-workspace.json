{
  "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logAnalyticsWorkspaceName": {
      "type": "string"
    },
    "logAnalyticsWorkspaceSku": {
      "type": "string",
      "allowedValues": [
        "PerGB2018",
        "PerNode"
      ]
    },
    "dataRetentionDays": {
      "type": "int",
      "defaultValue": 31,
      "minValue": 31,
      "maxValue": 730,
      "metadata": {
        "description": "Analytics (interactive) retention in days. This is the period the data is instantly searchable."
      }
    },
    "totalRetentionInDays": {
      "type": "int",
      "defaultValue": -1,
      "metadata": {
        "description": "Total retention in days applied to the tables listed in tableNames, between 4 and 4383. Data is held in low cost long term retention between dataRetentionDays and totalRetentionInDays and is retrieved using a search job. -1 defaults to dataRetentionDays and applies no long term retention."
      }
    },
    "tableNames": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Tables to apply totalRetentionInDays to. A table can only be configured once it exists in the workspace. An empty array deploys no table configuration."
      }
    },
    "dailyQuotaGb": {
      "type": "int",
      "defaultValue": -1,
      "metadata": {
        "description": "Daily ingestion cap in GB. -1 leaves the cap unmanaged by this template so an existing cap is not reset."
      }
    },
    "publicNetworkAccessForIngestion": {
      "type": "string",
      "defaultValue": "Enabled",
      "allowedValues": [
        "Enabled",
        "Disabled"
      ]
    },
    "publicNetworkAccessForQuery": {
      "type": "string",
      "defaultValue": "Enabled",
      "allowedValues": [
        "Enabled",
        "Disabled"
      ]
    },
    "disableLocalAuth": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Disables shared key authentication so that only Microsoft Entra authentication is accepted. Defaults to false to preserve the behaviour of workspaces deployed before this parameter existed."
      }
    },
    "enableDataExport": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enables the workspace data export feature. Required before a data export rule can be created against the workspace."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Resource tags. An empty object omits the property entirely so that tags applied outside this template are preserved."
      }
    }
  },
  "variables": {},
  "resources": [
    {
      "name": "[parameters('logAnalyticsWorkspaceName')]",
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2025-02-01",
      "location": "[resourceGroup().location]",
      "tags": "[if(empty(parameters('tags')), json('null'), parameters('tags'))]",
      "properties": {
        "sku": {
          "name": "[parameters('logAnalyticsWorkspaceSku')]"
        },
        "retentionInDays": "[parameters('dataRetentionDays')]",
        "publicNetworkAccessForIngestion": "[parameters('publicNetworkAccessForIngestion')]",
        "publicNetworkAccessForQuery": "[parameters('publicNetworkAccessForQuery')]",
        "workspaceCapping": "[if(equals(parameters('dailyQuotaGb'), -1), json('null'), createObject('dailyQuotaGb', parameters('dailyQuotaGb')))]",
        "features": {
          "enableLogAccessUsingOnlyResourcePermissions": true,
          "disableLocalAuth": "[parameters('disableLocalAuth')]",
          "enableDataExport": "[parameters('enableDataExport')]"
        }
      }
    },
    {
      "name": "[concat(parameters('logAnalyticsWorkspaceName'), '/', parameters('tableNames')[copyIndex()])]",
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2023-09-01",
      "properties": {
        "retentionInDays": "[parameters('dataRetentionDays')]",
        "totalRetentionInDays": "[parameters('totalRetentionInDays')]"
      },
      "copy": {
        "name": "tableRetentionCopy",
        "count": "[length(parameters('tableNames'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName'))]"
      ]
    }
  ],
  "outputs": {
    "resourceId": {
      "type": "string",
      "value": "[reference(parameters('logAnalyticsWorkspaceName'),'2020-08-01','Full').resourceId]"
    },
    "fullyQualifiedResourceId": {
      "type": "string",
      "value": "[concat('/subscriptions/',subscription().subscriptionId,'/resourcegroups/',resourceGroup().name,'/providers/',reference(parameters('logAnalyticsWorkspaceName'),'2020-08-01','Full').resourceId)]"
    }
  }
}
